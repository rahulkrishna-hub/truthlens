# Copy this file to .env and fill in your real values.
# NEVER commit .env, never paste keys into chat or code.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Primary model. If its free-tier quota is spent, the code automatically walks
# down its fallback chain (3.8 -> 3.7 -> 3.6 -> 3.5 -> flash-lite) and remembers
# the model that answered for 5 minutes, so there is no need to edit this often.
GEMINI_MODEL=gemini-flash-lite-latest

# Optional — only needed for the Telegram bot (bot.py)
TELEGRAM_BOT_TOKEN=

# Local storage paths (defaults shown; safe to leave as-is)
DB_PATH=truthlens.db
CHROMA_DIR=chroma_store

# Timeouts in seconds — these keep a slow answer from looking like a dead bot.
# Defaults shown; only set them if you need to tune them.
# WEB_SEARCH_TIMEOUT=20    # hard cap on one DuckDuckGo search
# LLM_TIMEOUT=60           # hard cap per Gemini model (then it tries the next one)
# BOT_CHECK_TIMEOUT=180    # hard cap on one Telegram fact-check before the bot replies "took too long"
# BOT_SLOW_NOTICE=20       # seconds before the bot edits "Still fact-checking…"
